# Data (raw/processed are regenerated by scripts/task2_preprocessing.py)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results (regenerated by scripts/task3-5_*.py) - keep the folder structure
results/*.csv
results/*.json
results/*.parquet
results/figures/*.png
results/tuned_params/*.json
!results/figures/.gitkeep
!results/tuned_params/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Models / large artifacts
*.h5
*.keras
*.pkl

# Env
.env
.venv/
venv/

# OS
.DS_Store
